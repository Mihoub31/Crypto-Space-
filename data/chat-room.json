const express = require("express");
const fs = require("fs");
const path = require("path");
const cors = require("cors");

const app = express();
const PORT = process.env.PORT || 3000;
const DATA_DIR = path.join(__dirname, "data");
const MESSAGES_PATH = path.join(DATA_DIR, "chat-room.json");
const STATIC_PATH = path.join(__dirname, "docs");

app.use(cors());
app.use(express.json({ limit: "1mb" }));
app.use(express.static(STATIC_PATH));

function ensureDataFile() {
  if (!fs.existsSync(DATA_DIR)) {
    fs.mkdirSync(DATA_DIR, { recursive: true });
  }

  if (!fs.existsSync(MESSAGES_PATH)) {
    const defaultData = {
      General: [{ name: "Team", text: "Welcome to General. Share your thoughts on today’s market trends." }],
      Support: [{ name: "Team", text: "Need help with a crypto question? Ask the community here." }],
      Ideas: [{ name: "Team", text: "Share ideas, narratives, and new opportunities with the room." }]
    };

    fs.writeFileSync(MESSAGES_PATH, JSON.stringify(defaultData, null, 2));
  }
}

function readMessages() {
  ensureDataFile();
  try {
    return JSON.parse(fs.readFileSync(MESSAGES_PATH, "utf8"));
  } catch (error) {
    return {
      General: [{ name: "Team", text: "Welcome to General. Share your thoughts on today’s market trends." }],
      Support: [{ name: "Team", text: "Need help with a crypto question? Ask the community here." }],
      Ideas: [{ name: "Team", text: "Share ideas, narratives, and new opportunities with the room." }]
    };
  }
}

function writeMessages(payload) {
  fs.writeFileSync(MESSAGES_PATH, JSON.stringify(payload, null, 2));
}

app.get("/api/messages", (req, res) => {
  const data = readMessages();
  res.json(data);
});

app.post("/api/messages", (req, res) => {
  const { channel, name, text } = req.body || {};
  if (!channel || !text) {
    return res.status(400).json({ error: "Channel and message are required." });
  }

  const messages = readMessages();
  const safeChannel = channel.trim();
  const safeName = (name || "Guest").trim() || "Guest";
  const safeText = text.trim();

  if (!messages[safeChannel]) {
    messages[safeChannel] = [];
  }

  messages[safeChannel].push({ name: safeName, text: safeText });
  writeMessages(messages);

  res.status(201).json({ ok: true, messages });
});

app.get("/", (req, res) => {
  res.sendFile(path.join(STATIC_PATH, "index.html"));
});

app.get("/*", (req, res) => {
  const candidate = path.join(STATIC_PATH, req.path);
  if (fs.existsSync(candidate) && fs.statSync(candidate).isFile()) {
    return res.sendFile(candidate);
  }
  res.sendFile(path.join(STATIC_PATH, "index.html"));
});

app.listen(PORT, () => {
  console.log(`Ledgerline backend running at http://localhost:${PORT}`);
});












































































































































































































