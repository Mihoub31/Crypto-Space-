const channelNames = ["General", "Support", "Ideas"];

const appState = {
  theme: localStorage.getItem("ledgerline-theme") || "light",
  sortKey: "change24h",
  sortDirection: "desc",
  trendFilter: "all",
  search: "",
  marketRows: [],
  chatData: null,
  activeChannel: "General"
};

function formatPrice(value) {
  if (value === null || value === undefined) return "n/a";
  if (value >= 1000) return `$${value.toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
  if (value >= 1) return `$${value.toLocaleString(undefined, { maximumFractionDigits: 4 })}`;
  return `$${value.toLocaleString(undefined, { maximumFractionDigits: 6 })}`;
}

function formatCompactNumber(value) {
  if (value === null || value === undefined) return "n/a";
  if (value >= 1_000_000_000) return `$${(value / 1_000_000_000).toFixed(1)}B`;
  if (value >= 1_000_000) return `$${(value / 1_000_000).toFixed(1)}M`;
  if (value >= 1_000) return `$${(value / 1_000).toFixed(1)}K`;
  return `$${value.toFixed(0)}`;
}

function formatChange(value) {
  const sign = value >= 0 ? "+" : "";
  return `${sign}${value.toFixed(1)}%`;
}

function getTopEntry(rows) {
  if (!rows || !rows.length) return null;
  return [...rows].sort((a, b) => b.change24h - a.change24h)[0];
}

function renderThemeToggle() {
  const button = document.getElementById("themeToggle");
  if (!button) return;

  button.textContent = appState.theme === "dark" ? "☀️" : "🌙";
  document.body.setAttribute("data-theme", appState.theme);
  localStorage.setItem("ledgerline-theme", appState.theme);
}

function applyTheme() {
  renderThemeToggle();
}

function getRowsFromData(data) {
  if (!data?.sources) return fallbackData.sources.Binance;

  const mergedRows = Object.values(data.sources).flat();
  return mergedRows.filter((entry) => entry && typeof entry.symbol === "string");
}

function getVisibleRows() {
  const rows = [...appState.marketRows];

  const filtered = rows.filter((row) => {
    const matchText = row.symbol.toLowerCase().includes(appState.search.toLowerCase());
    const matchTrend =
      appState.trendFilter === "all" ||
      (appState.trendFilter === "up" && row.change24h >= 0) ||
      (appState.trendFilter === "down" && row.change24h < 0);

    return matchText && matchTrend;
  });

  return filtered.sort((a, b) => {
    const left = a[appState.sortKey];
    const right = b[appState.sortKey];

    if (typeof left === "string" && typeof right === "string") {
      return appState.sortDirection === "asc" ? left.localeCompare(right) : right.localeCompare(left);
    }

    const diff = Number(left) - Number(right);
    return appState.sortDirection === "asc" ? diff : -diff;
  });
}

function renderMetricCards(data) {
  const rows = getRowsFromData(data);
  const btc = rows.find((row) => row.symbol === "BTC") || rows[0];
  const eth = rows.find((row) => row.symbol === "ETH") || rows[1] || rows[0];

  const btcPrice = document.getElementById("btcPrice");
  const ethPrice = document.getElementById("ethPrice");
  const marketCap = document.getElementById("marketCap");
  const volume = document.getElementById("volume");

  if (btcPrice) btcPrice.textContent = btc ? formatPrice(btc.price) : "$64,280";
  if (ethPrice) ethPrice.textContent = eth ? formatPrice(eth.price) : "$3,420";
  if (marketCap) marketCap.textContent = "$2.6T";
  if (volume) volume.textContent = "$89.4B";
}

function renderGainers(data) {
  const rows = getRowsFromData(data);
  appState.marketRows = rows.slice(0, 12).sort((a, b) => b.change24h - a.change24h);

  const tableBody = document.getElementById("gainersTableBody");
  if (!tableBody) return;

  const visibleRows = getVisibleRows();

  tableBody.innerHTML = visibleRows
    .map((entry) => {
      const trendClass = entry.change24h >= 0 ? "row-up" : "row-down";
      const badge = entry.symbol.slice(0, 2).toUpperCase();
      return `
        <tr>
          <td>
            <div class="coin-cell">
              <span class="coin-badge">${badge}</span>
              <span>${entry.symbol}</span>
            </div>
          </td>
          <td>${formatPrice(entry.price)}</td>
          <td class="${trendClass}">${formatChange(entry.change24h)}</td>
          <td>${formatCompactNumber(entry.volume24h)}</td>
          <td>${formatCompactNumber(entry.marketCap || entry.volume24h * 2.5)}</td>
        </tr>
      `;
    })
    .join("");

  const top = getTopEntry(appState.marketRows);
  const topGainer = document.getElementById("topGainer");
  const topGainerMove = document.getElementById("topGainerMove");

  if (top && topGainer) {
    topGainer.textContent = top.symbol;
    topGainerMove.textContent = formatChange(top.change24h);
  }

  const updatedEl = document.getElementById("gainerUpdated");
  const updatedTimeEl = document.getElementById("updatedTime");

  if (updatedEl) {
    const updated = data?.updated ? new Date(data.updated) : new Date();
    updatedEl.textContent = `Updated ${updated.toLocaleString([], { dateStyle: "medium", timeStyle: "short" })}`;
  }

  if (updatedTimeEl) {
    const updated = data?.updated ? new Date(data.updated) : new Date();
    updatedTimeEl.textContent = updated.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  }
}

function buildSparkline(points, color) {
  const width = 320;
  const height = 120;
  const min = Math.min(...points);
  const max = Math.max(...points);
  const range = max - min || 1;

  const coords = points
    .map((point, index) => {
      const x = (index / (points.length - 1)) * width;
      const y = height - ((point - min) / range) * (height - 10) - 5;
      return `${x},${y}`;
    })
    .join(" ");

  return `
    <svg class="sparkline" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" aria-label="Trend line" role="img">
      <defs>
        <linearGradient id="grad-${color.replace('#', '')}" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="${color}" stop-opacity="0.6" />
          <stop offset="100%" stop-color="${color}" stop-opacity="0.04" />
        </linearGradient>
      </defs>
      <polyline fill="none" stroke="${color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="${coords}" />
    </svg>
  `;
}

function renderCharts() {
  const chartGrid = document.getElementById("chartGrid");
  if (!chartGrid) return;

  const entries = Object.entries(chartSeries)
    .map(([symbol, values]) => ({ symbol, values }))
    .slice(0, 3);

  chartGrid.innerHTML = entries
    .map(({ symbol, values }) => {
      const color = symbol === "BTC" ? "#5a52ff" : symbol === "ETH" ? "#0d9d69" : "#f59e0b";
      return `
        <div class="chart-card">
          <div class="chart-header">
            <strong>${symbol}</strong>
            <span class="trend up">+${((values[values.length - 1] - values[0]) / values[0] * 100).toFixed(1)}%</span>
          </div>
          ${buildSparkline(values, color)}
        </div>
      `;
    })
    .join("");
}

function renderNews() {
  const newsGrid = document.getElementById("newsGrid");
  if (!newsGrid) return;

  newsGrid.innerHTML = newsItems
    .map(
      (item) => `
        <article class="news-card">
          <div class="news-card-top">
            <span class="news-category">${item.category}</span>
            <h3>${item.title}</h3>
            <p>${item.summary}</p>
          </div>
          <div class="news-card-bottom">
            <span>${item.time}</span>
            <a href="${item.link}" class="news-link">Read more</a>
          </div>
        </article>
      `
    )
    .join("");
}

function loadMessages() {
  const saved = localStorage.getItem("ledgerline-room");
  if (saved) {
    try {
      return JSON.parse(saved);
    } catch (error) {
      console.warn("Unable to parse saved room state.", error);
    }
  }

  return Object.fromEntries(
    channelNames.map((channel) => [channel, [{ name: "Team", text: `Welcome to ${channel}. Share your latest crypto take.` }]])
  );
}

async function fetchMessages() {
  try {
    const response = await fetch("/api/messages", { cache: "no-store" });
    if (!response.ok) throw new Error("Backend unavailable");
    const data = await response.json();
    appState.chatData = data;
    return data;
  } catch (error) {
    appState.chatData = loadMessages();
    return appState.chatData;
  }
}

async function postMessage(payload) {
  try {
    const response = await fetch("/api/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      throw new Error("Unable to save to backend");
    }

    const data = await response.json();
    appState.chatData = data.messages;
    return data.messages;
  } catch (error) {
    const room = loadMessages();
    room[payload.channel] = room[payload.channel] || [];
    room[payload.channel].push({ name: payload.name, text: payload.text });
    appState.chatData = room;
    localStorage.setItem("ledgerline-room", JSON.stringify(room));
    return room;
  }
}

function renderChannelTabs() {
  const channelTabs = document.getElementById("channelTabs");
  if (!channelTabs) return;

  channelTabs.innerHTML = channelNames
    .map(
      (channel) => `
        <button class="channel-tab ${channel === appState.activeChannel ? "active" : ""}" type="button" data-channel="${channel}">${channel}</button>
      `
    )
    .join("");

  channelTabs.querySelectorAll(".channel-tab").forEach((button) => {
    button.addEventListener("click", () => {
      appState.activeChannel = button.dataset.channel;
      renderChannelTabs();
      renderChat();
    });
  });
}

function renderChat() {
  const chatLog = document.getElementById("chatLog");
  if (!chatLog) return;

  const room = appState.chatData || loadMessages();
  const messages = room[appState.activeChannel] || [];

  chatLog.innerHTML = messages.length
    ? messages
        .map(
          (message) => `
            <div class="chat-message">
              <strong>${message.name}</strong>
              <span>${message.text}</span>
            </div>
          `
        )
        .join("")
    : '<div class="chat-empty">No messages yet. Start the conversation.</div>';

  chatLog.scrollTop = chatLog.scrollHeight;
}

async function sendChatMessage() {
  const messageInput = document.getElementById("messageInput");
  const nameInput = document.getElementById("nameInput");
  const text = messageInput?.value.trim();
  if (!text) return;

  const payload = {
    channel: appState.activeChannel,
    name: nameInput?.value.trim() || "Guest",
    text
  };

  const nextRoom = await postMessage(payload);
  appState.chatData = nextRoom;
  renderChat();
  if (messageInput) messageInput.value = "";
}

function bindControls() {
  const themeToggle = document.getElementById("themeToggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      appState.theme = appState.theme === "dark" ? "light" : "dark";
      applyTheme();
    });
  }

  const searchInput = document.getElementById("marketSearch");
  const trendFilter = document.getElementById("trendFilter");
  const sortSelect = document.getElementById("sortSelect");

  if (searchInput) {
    searchInput.addEventListener("input", (event) => {
      appState.search = event.target.value.trim();
      renderGainers({ sources: { Binance: appState.marketRows } });
    });
  }

  if (trendFilter) {
    trendFilter.addEventListener("change", (event) => {
      appState.trendFilter = event.target.value;
      renderGainers({ sources: { Binance: appState.marketRows } });
    });
  }

  if (sortSelect) {
    sortSelect.addEventListener("change", (event) => {
      appState.sortKey = event.target.value;
      appState.sortDirection = appState.sortKey === "symbol" ? "asc" : "desc";
      renderGainers({ sources: { Binance: appState.marketRows } });
    });
  }

  const sendBtn = document.getElementById("sendBtn");
  if (sendBtn) {
    sendBtn.addEventListener("click", sendChatMessage);
  }

  const messageInput = document.getElementById("messageInput");
  if (messageInput) {
    messageInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        sendChatMessage();
      }
    });
  }
}

async function init() {
  applyTheme();
  bindControls();
  renderCharts();
  renderNews();

  try {
    const response = await fetch("./gainers.json", { cache: "no-store" });
    if (!response.ok) throw new Error("Fallback to sample data");
    const data = await response.json();
    renderMetricCards(data);
    renderGainers(data);
  } catch (error) {
    renderMetricCards(fallbackData);
    renderGainers(fallbackData);
  }

  appState.chatData = await fetchMessages();
  renderChannelTabs();
  renderChat();
}

window.addEventListener("DOMContentLoaded", init);























































































































































































































































































