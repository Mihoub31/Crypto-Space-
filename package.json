const express = require("express");
const fs = require("fs");
const path = require("path");
const cors = require("cors");

const app = express();
const PORT = process.env.PORT || 3000;
const DATA_DIR = path.join(__dirname, "data");
const STORAGE_PATH = path.join(DATA_DIR, "chat-room.json");
const STATIC_PATH = path.join(__dirname, "docs");

app.use(cors());
app.use(express.json({ limit: "1mb" }));
app.use(express.static(STATIC_PATH));

function ensureData() {
  if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

  if (!fs.existsSync(STORAGE_PATH)) {
    const template = {
      General: [{ name: "Team", text: "Welcome to General. Share your thoughts on the latest market trend." }],
      Support: [{ name: "Team", text: "Need help? Ask here and the community will respond." }],
      Ideas: [{ name: "Team", text: "Share new coin ideas, narratives, and macro observations." }]
    };
    fs.writeFileSync(STORAGE_PATH, JSON.stringify(template, null, 2));
  }
}

function readMessages() {
  ensureData();
  try {
    return JSON.parse(fs.readFileSync(STORAGE_PATH, "utf8"));
  } catch (error) {
    return {
      General: [{ name: "Team", text: "Welcome to General. Share your thoughts on the latest market trend." }],
      Support: [{ name: "Team", text: "Need help? Ask here and the community will respond." }],
      Ideas: [{ name: "Team", text: "Share new coin ideas, narratives, and macro observations." }]
    };
  }
}

function writeMessages(messages) {
  fs.writeFileSync(STORAGE_PATH, JSON.stringify(messages, null, 2));
}

async function fetchCoinGeckoMarkets() {
  const url = "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin,ethereum,solana,ripple,cardano,chainlink,arbitrum,dogecoin,avalanche,tron&order=market_cap_desc&per_page=12&page=1&sparkline=true&price_change_percentage=24h";
  const response = await fetch(url, { headers: { "accept": "application/json" } });
  if (!response.ok) throw new Error("CoinGecko unavailable");
  const data = await response.json();
  return data.map((coin) => ({
    symbol: coin.symbol.toUpperCase(),
    name: coin.name,
    price: coin.current_price,
    change24h: coin.price_change_percentage_24h || 0,
    volume24h: coin.total_volume || 0,
    marketCap: coin.market_cap || 0,
    image: coin.image,
    id: coin.id,
    marketCapRank: coin.market_cap_rank || null
  }));
}

async function fetchCoinGeckoDetail(symbol) {
  const cached = [
    { id: "bitcoin", symbol: "BTC" },
    { id: "ethereum", symbol: "ETH" },
    { id: "solana", symbol: "SOL" },
    { id: "ripple", symbol: "XRP" },
    { id: "cardano", symbol: "ADA" },
    { id: "chainlink", symbol: "LINK" },
    { id: "arbitrum", symbol: "ARB" },
    { id: "dogecoin", symbol: "DOGE" },
    { id: "avalanche-2", symbol: "AVAX" },
    { id: "tron", symbol: "TRX" }
  ];

  const lookup = cached.find((item) => item.symbol.toLowerCase() === String(symbol).toLowerCase());
  const id = lookup ? lookup.id : symbol;
  const url = `https://api.coingecko.com/api/v3/coins/${id}?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false&sparkline=true`;
  const response = await fetch(url, { headers: { "accept": "application/json" } });
  if (!response.ok) throw new Error("Coin detail unavailable");
  const coin = await response.json();

  return {
    id: coin.id,
    name: coin.name,
    symbol: coin.symbol.toUpperCase(),
    current_price: coin.market_data?.current_price?.usd ?? null,
    price_change_percentage_24h: coin.market_data?.price_change_percentage_24h ?? 0,
    total_volume: coin.market_data?.total_volume?.usd ?? 0,
    market_cap: coin.market_data?.market_cap?.usd ?? 0,
    market_cap_rank: coin.market_cap_rank ?? null,
    image: coin.image?.small || ""
  };
}

app.get("/api/market", async (req, res) => {
  try {
    const rows = await fetchCoinGeckoMarkets();
    res.json({ updated: new Date().toISOString(), rows });
  } catch (error) {
    res.status(502).json({
      updated: new Date().toISOString(),
      rows: [
        { symbol: "BTC", name: "Bitcoin", price: 64280, change24h: 1.8, volume24h: 33200000000, marketCap: 1270000000000 },
        { symbol: "ETH", name: "Ethereum", price: 3420, change24h: 2.3, volume24h: 16100000000, marketCap: 411000000000 },
        { symbol: "SOL", name: "Solana", price: 146.5, change24h: 4.2, volume24h: 3870000000, marketCap: 67000000000 },
        { symbol: "XRP", name: "XRP", price: 0.58, change24h: 1.5, volume24h: 2330000000, marketCap: 32900000000 }
      ]
    });
  }
});

app.get("/api/coin/:symbol", async (req, res) => {
  try {
    const detail = await fetchCoinGeckoDetail(req.params.symbol);
    res.json(detail);
  } catch (error) {
    const fallback = {
      symbol: req.params.symbol.toUpperCase(),
      name: req.params.symbol.toUpperCase(),
      current_price: null,
      price_change_percentage_24h: 0,
      total_volume: 0,
      market_cap: 0,
      market_cap_rank: null,
      image: ""
    };
    res.json(fallback);
  }
});

app.get("/api/messages", (req, res) => {
  res.json(readMessages());
});

app.post("/api/messages", (req, res) => {
  const { channel, name, text } = req.body || {};
  if (!channel || !text) {
    return res.status(400).json({ error: "Channel and message are required." });
  }

  const messages = readMessages();
  const safeChannel = channel.trim();
  messages[safeChannel] = messages[safeChannel] || [];
  messages[safeChannel].push({ name: (name || "Guest").trim() || "Guest", text: String(text).trim() });
  writeMessages(messages);
  res.status(201).json({ ok: true, messages });
});

app.get("/", (req, res) => {
  res.sendFile(path.join(STATIC_PATH, "index.html"));
});

app.get("/*", (req, res) => {
  const candidate = path.join(STATIC_PATH, req.path);
  if (fs.existsSync(candidate) && fs.statSync(candidate).isFile()) {
    return res.sendFile(candidate);
  }
  res.sendFile(path.join(STATIC_PATH, "index.html"));
});

app.listen(PORT, () => {
  console.log(`Ledgerline backend running at http://localhost:${PORT}`);
});


















































































































































































































































